/target/

# Generated benchmark reports, experiment outputs, and review evidence stay local.
/suite/reports/
/review/
/docs/evidence/
/docs/review-evidence/
/docs/*-evidence/
/docs/*-validation/
/docs/*-validation-*/
/perf.data
/perf.data.old
*.profraw
*.profdata

# Cargo/private outputs and archived proof work are not source inputs.
**/target/
/PRIVATE/
/suite/evidence/
/artifacts.lock.json
/docs/*202610*.json
/docs/*202610*.html

# Kernel audit runs are evidence, not pinned fixture inputs.
/suite/linux-kernel/audit-*.json
/docs/benchmarks/bbtree-*.json

{
  "experiment": "Bounded AArch64 allocated switch-tail replication",
  "base_commit": "f9f8dad2",
  "implementation_commit": "ea287bb2",
  "activation": "ExperimentalDispatchTails(&selector) as CodegenPipeline.selector; default-false InstructionSelector::experimental_aarch64_dispatch_tails hook",
  "limits": {
    "cases_min": 4,

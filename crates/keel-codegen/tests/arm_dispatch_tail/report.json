  "contract": [
    "Original Jump before edits and parallel edge/parameter copies run first.",
    "Original Switch instruction index supplies before edits, operand locations and successor edge edits.",
    "Only emitted assembly labels/table identities gain the Jump-site suffix.",
    "current_inst, allocation_index and physical next_block state are restored.",
    "Unsigned bounds checks, default trap, all case edges and original Switch remain."
  ],
  "rejections": [
    "Fast allocator",
    "InlineAsm anywhere in function",
    "source/debug metadata",
    "custom selection constraints",
    "covered terminators",
    "terminator after edits or definition overrides",
    "non-switch-only target blocks",
    "sparse or out-of-budget tables"
  ],
  "coverage": [
    "32/64-bit keys",
    "nonempty block parameter copies",
    "direct downstream uses of shared dispatch parameters",
    "multiple copied tables and unique labels",
    "switch instruction use overrides and before-copy cycles",
    "combined successor-edge and phi-copy cycles",
    "all values forced to spills",
    "normal edges entering retained original Switch",
    "sparse default pad regression",
    "case-count/clone/table-entry limits",
    "Fast output unchanged",
    "structured and text objects byte-identical",
    "unsupported terminator after-transfer rejected before emission"
  ],

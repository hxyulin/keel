func @trap_only() {
block0:
    trap
}

func @trap_increment(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 1
    v2 = iadd v0, v1
    return v2
}

func @guarded_trap(ptr, i64) -> i64 {
    ss0 = stack_slot 16, align 16
block0(v0: ptr, v1: i64):
    v2 = stack_addr ss0
    store v1, v2
    v3 = call @trap_increment(v1)
    v4 = load.i64 v2
    brif v4, block1, block2
block1:
    v5 = iconst.i32 73
    store v5, v0
    trap
block2:
    return v3
}

; Locations as a frontend would write them, for a calc.rs that does not
; exist: the line table is all lldb needs to place breakpoints.
file f0 = "calc.rs"

func @calc(i64) -> i64 cc(c) {
block0(v0: i64):
    v1 = iconst.i64 3 !f0:2:13
    v2 = imul v0, v1 !f0:2:11
    v3 = iconst.i64 1 !f0:3:16
    v4 = iadd v2, v3 !f0:3:14
    return v4 !f0:3:5
}

; Without columns, the prologue and the first instruction share a location;
; the instruction must still be marked as the end of the prologue.
func @nocol(i64) -> i64 cc(c) {
block0(v0: i64):
    v1 = iconst.i64 1 !f0:6:0
    v2 = iadd v0, v1 !f0:6:0
    return v2 !f0:7:0
}

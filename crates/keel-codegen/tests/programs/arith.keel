; Swaps (a, b) n times through block arguments: the copies must happen at
; once, or both parameters end up with the same value.
func @swap_loop(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    jump block1(v0, v1, v2)
block1(v3: i64, v4: i64, v5: i64):
    v6 = iconst.i64 0
    v7 = icmp.eq v5, v6
    brif v7, block2, block3
block3:
    v8 = iconst.i64 1
    v9 = isub v5, v8
    jump block1(v4, v3, v9)
block2:
    v10 = iconst.i64 10
    v11 = imul v3, v10
    v12 = iadd v11, v4
    return v12
}

; A brif whose else-edge carries arguments.
func @max64(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = icmp.sgt v0, v1
    brif v2, block1(v0), block1(v1)
block1(v3: i64):
    return v3
}

func @k_smax_i8(ptr, i8 sext) -> i8 sext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_rmw.smax seq_cst v0, v1
    return v2
}

func @k_cas_i8(ptr, i8 uext, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8, v2: i8):
    v3 = atomic_cas relaxed v0, v1, v2
    return v3
}

; Loads the old value, stores the new one, returns the old.
func @k_swap_i8(ptr, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_load.i8 seq_cst v0
    fence acquire
    atomic_store seq_cst v1, v0
    fence seq_cst
    return v2
}


; Atomics: every atomic_rmw operation at every width, compare and swap,
; loads and stores, checked in atomics.c. The orderings cycle through
; every one each instruction allows. Threads then hammer a counter
; with atomic_rmw.add, and a spinlock built from atomic_cas (acquire)
; and atomic_store (release) guards a plain counter.
; expect: exit 0

func @k_add_i8(ptr, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_rmw.add relaxed v0, v1
    return v2
}

func @k_sub_i8(ptr, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_rmw.sub acquire v0, v1
    return v2
}

func @k_and_i8(ptr, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_rmw.and release v0, v1
    return v2
}

func @k_or_i8(ptr, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_rmw.or acq_rel v0, v1
    return v2
}

func @k_xor_i8(ptr, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_rmw.xor seq_cst v0, v1
    return v2
}

func @k_xchg_i8(ptr, i8 uext) -> i8 uext cc(c) {
block0(v0: ptr, v1: i8):
    v2 = atomic_rmw.xchg relaxed v0, v1
    return v2
}


func @k_xchg_ptr(ptr, ptr) -> ptr cc(c) {
block0(v0: ptr, v1: ptr):
    v2 = atomic_rmw.xchg seq_cst v0, v1
    v3 = atomic_load.ptr acquire v0
    v4 = atomic_cas acq_rel v0, v3, v2
    return v4
}

; Adds 1 to *v0, v1 times.
func @k_count(ptr, i64) cc(c) {
block0(v0: ptr, v1: i64):
    v2 = iconst.i64 0
    jump block1(v2)
block1(v3: i64):
    v4 = icmp.ult v3, v1
    brif v4, block2, block3
block2:
    v5 = iconst.i64 1
    v6 = atomic_rmw.add relaxed v0, v5
    v7 = iadd v3, v5
    jump block1(v7)
block3:
    return
}

; Spins until *v0 goes from 0 to 1.
func @k_lock(ptr) cc(c) {
block0(v0: ptr):
    v1 = iconst.i32 0
    v2 = iconst.i32 1
    jump block1
block1:
    v3 = atomic_cas acquire v0, v1, v2
    v4 = icmp.eq v3, v1
    brif v4, block2, block1
block2:
    return
}

func @k_unlock(ptr) cc(c) {
block0(v0: ptr):
    v1 = iconst.i32 0
    atomic_store release v1, v0
    return
}

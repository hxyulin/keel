block1(v2: i128):
    v3 = iconst.i128 1
    v4 = iadd v2, v3
    v5 = iconst.i128 64
    v6 = shl v4, v5
    v7 = ushr v6, v5
    v8 = bnot v7
    v9 = shl v8, v5
    v10 = or v7, v9
    v11, v12 = atomic_cas weak acq_rel relaxed v0, v2, v10
    brif v12, block2, block1(v11)
block2:
    return
}

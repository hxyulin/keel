; Adds one to the pair's counter and keeps the high half its complement,
; with a weak compare-and-swap loop that branches on the flag.
func @k_bump(ptr) cc(c) target_features("cx16") {
block0(v0: ptr):
    v1 = atomic_load.i128 relaxed v0

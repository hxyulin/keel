; expect: exit 0
func @edge_locations(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    brif v0, block1(v1), block1(v2)
block1(v3: i64):
    v4 = iadd v3, v1
    return v4
}

func @empty_branch(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    brif v0, block1(), block2()
block1:
    v3 = isub v1, v2
    return v3
block2:
    v4 = iadd v1, v2
    return v4
}

func @empty_switch(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    switch v0, block1(), [1: block2(), 2: block2(), 3: block2(), 4: block2()]
block1:
    v3 = isub v1, v2
    return v3
block2:
    v4 = iadd v1, v2
    return v4
}

; expect: exit 0
; i128 operations and calling convention, checked against C's __int128 in
; i128.c. An i128 takes the next two x registers, low half first, with no
; rounding to an even register (Apple's rule); on the stack it takes 16
; bytes, 16-aligned; it is returned in x0:x1.

func @k_iadd(i128, i128) -> i128 {
block0(v0: i128, v1: i128):
    v2 = iadd v0, v1
    return v2
}


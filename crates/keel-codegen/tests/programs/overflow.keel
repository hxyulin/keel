block0(v0: i8, v1: i8, v2: ptr):
    v3, v4 = usub_overflow v0, v1
    store v4, v2
    return v3
}

func @k_ssub_i8(i8 sext, i8 sext, ptr) -> i8 sext cc(c) {
block0(v0: i8, v1: i8, v2: ptr):
    v3, v4 = ssub_overflow v0, v1

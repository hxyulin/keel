; Every *_overflow operation at every width, checked against clang's
; __builtin_*_overflow in overflow.c. Each k_<op>_<type> returns the
; wrapped result and stores the flag through its third argument.
; k_live keeps both results alive across a call.
; expect: exit 0

func @k_uadd_i8(i8 uext, i8 uext, ptr) -> i8 uext cc(c) {
block0(v0: i8, v1: i8, v2: ptr):
    v3, v4 = uadd_overflow v0, v1
    store v4, v2
    return v3
}

func @k_sadd_i8(i8 sext, i8 sext, ptr) -> i8 sext cc(c) {
block0(v0: i8, v1: i8, v2: ptr):
    v3, v4 = sadd_overflow v0, v1
    store v4, v2
    return v3
}


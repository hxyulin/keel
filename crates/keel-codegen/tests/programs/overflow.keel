decl @clobber()

; Returns 2 * (a + b) + overflow flag, with both results live across a call.
func @k_live(i64, i64) -> i64 cc(c) {
block0(v0: i64, v1: i64):
    v2, v3 = uadd_overflow v0, v1
    call @clobber()
    v4 = uext.i64 v3
    v5 = iadd v2, v2
    v6 = iadd v5, v4
    return v6
}

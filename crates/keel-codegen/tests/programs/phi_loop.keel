; expect: exit 0
; opt-passes: instcombine, phi-simplify, simplify-cfg, gvn, phi-simplify, dce, gcm
func @phi_loop(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    v3 = iconst.i64 1
    jump block1(v0, v2)
block1(v4: i64, v5: i64):
    v6 = icmp.ult v5, v1
    brif v6, block2, block3(v4)
block2:
    v7 = iadd v5, v3
    jump block1(v4, v7)
block3(v8: i64):
    return v8
}

func @edge_transfers(ptr, i64, i64, i64) -> i64 {
block0(v0:ptr,v1:i64,v2:i64,v3:i64):
 v4 = iconst.i64 0
 jump block1(v4,v2,v3)
block1(v5:i64,v6:i64,v7:i64):
 v8 = icmp.ult v5,v1
 brif v8,block2,block5
block2:
 v9 = ptradd v0,v5
 v10 = load.i8 v9
 v11 = iconst.i8 0
 v12 = icmp.eq v10,v11
 brif v12,block3,block4
block3:
 v13 = iadd v6,v7
 jump block6(v13,v6)
block4:
 v14 = xor v6,v7
 jump block6(v7,v14)
block6(v15:i64,v16:i64):
 v17 = iconst.i64 1
 v18 = iadd v5,v17
 jump block1(v18,v15,v16)
block5:
 v19 = xor v6,v7
 return v19
}

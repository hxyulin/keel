; expect: exit 0
; Recursive keel -> keel calls. @main calls functions defined after it.
; Returns 0, or the number of the last failing check.
func @main() -> i32 {
block0:
    v0 = iconst.i32 0
    ; check 1: fib(10) = 55
    v1 = iconst.i64 10
    v2 = call @fib(v1)
    v3 = iconst.i64 55
    v4 = icmp.ne v2, v3
    v5 = iconst.i32 1
    v6 = select v4, v5, v0
    ; check 2: fib(20) = 6765
    v7 = iconst.i64 20
    v8 = call @fib(v7)
    v9 = iconst.i64 6765
    v10 = icmp.ne v8, v9
    v11 = iconst.i32 2
    v12 = select v10, v11, v6
    ; check 3: fact(20) = 2432902008176640000
    v13 = iconst.i64 20
    v14 = call @fact(v13)
    v15 = iconst.i64 2432902008176640000
    v16 = icmp.ne v14, v15
    v17 = iconst.i32 3
    v18 = select v16, v17, v12
    return v18
}

; fib(n) = n < 2 ? n : fib(n - 1) + fib(n - 2)
func @fib(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 2
    v2 = icmp.ult v0, v1
    brif v2, block2(v0), block1
block1:
    v3 = iconst.i64 1
    v4 = isub v0, v3
    v5 = call @fib(v4)
    v6 = isub v0, v1
    v7 = call @fib(v6)
    v8 = iadd v5, v7
    jump block2(v8)
block2(v9: i64):
    return v9
}

; fact(n) = n == 0 ? 1 : n * fact(n - 1)
func @fact(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = icmp.eq v0, v1
    v3 = iconst.i64 1
    brif v2, block2(v3), block1
block1:
    v4 = isub v0, v3
    v5 = call @fact(v4)
    v6 = imul v0, v5
    jump block2(v6)
block2(v7: i64):
    return v7
}

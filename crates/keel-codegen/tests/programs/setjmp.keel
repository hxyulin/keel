; setjmp and longjmp. Values live across setjmp are used after its second
; return, while the path from its first return fills registers and spill
; slots with other values before the longjmp: the live values must keep
; locations nothing else takes. The two functions differ in branch order,
; which decides whether the second-return block is laid out first.
; Both return x times 326.
; expect: exit 0

decl @setjmp(ptr) -> i32 cc(c) returns_twice
decl @longjmp(ptr, i32)

data @sink = align 8 { i64 0 }

func @k_setjmp(i64) -> i64 cc(c) {
    ss0 = stack_slot 192, align 16
block0(v0: i64):

    v29 = stack_addr ss0
    v30 = call @setjmp(v29)
    v31 = iconst.i32 0
    v32 = icmp.ne v30, v31
    brif v32, block2, block1
block1:
    v33 = iconst.i64 101
    v34 = imul v0, v33
    v35 = iconst.i64 103
    v36 = imul v0, v35

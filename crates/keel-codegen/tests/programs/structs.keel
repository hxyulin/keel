; Registers run out: the struct and everything after it are on the stack.
func @k_after7(i64, i64, i64, i64, i64, i64, i64, ptr byval {i64, i64}, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: ptr, v8: i64):
    v9 = call @h_after7(v0, v1, v2, v3, v4, v5, v6, v7, v8)
    return v9
}


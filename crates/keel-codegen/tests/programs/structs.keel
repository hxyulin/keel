block0(v0: f64, v1: f64, v2: f64, v3: f64, v4: f64, v5: f64, v6: f64, v7: ptr, v8: f32):
    v9 = call @h_fafter(v0, v1, v2, v3, v4, v5, v6, v7, v8)
    return v9
}

; A small struct, a float aggregate (in s0-s2) and a big struct (its
; address on the stack), after the general registers are used up.
func @k_after8(i64, i64, i64, i64, i64, i64, i64, i64, ptr byval {i8, i8, i8}, ptr byval {f32, f32, f32}, ptr byval {[5 x i64]}, i32) -> i64 {
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: ptr, v9: ptr, v10: ptr, v11: i32):
    v12 = call @h_after8(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11)
    return v12
}

func @k_pass_after7(ptr) -> i64 {
block0(v0: ptr):
    v1 = iconst.i64 1
    v2 = iconst.i64 2
    v3 = iconst.i64 3
    v4 = iconst.i64 4
    v5 = iconst.i64 5
    v6 = iconst.i64 6
    v7 = iconst.i64 7
    v8 = iconst.i64 8
    v9 = call @c_after7(v1, v2, v3, v4, v5, v6, v7, v0, v8)
    return v9
}

func @k_pass_fafter(ptr) -> i64 {
block0(v0: ptr):
    v1 = fconst.f64 1.0
    v2 = fconst.f64 2.0
    v3 = fconst.f64 3.0
    v4 = fconst.f64 4.0
    v5 = fconst.f64 5.0
    v6 = fconst.f64 6.0
    v7 = fconst.f64 7.0
    v8 = fconst.f32 0.5
    v9 = call @c_fafter(v1, v2, v3, v4, v5, v6, v7, v0, v8)
    return v9
}

func @k_pass_after8(ptr, ptr, ptr) -> i64 {
block0(v0: ptr, v1: ptr, v2: ptr):
    v3 = iconst.i64 1
    v4 = iconst.i64 2
    v5 = iconst.i64 3
    v6 = iconst.i64 4
    v7 = iconst.i64 5
    v8 = iconst.i64 6
    v9 = iconst.i64 7
    v10 = iconst.i64 8
    v11 = iconst.i32 -9
    v12 = call @c_after8(v3, v4, v5, v6, v7, v8, v9, v10, v0, v1, v2, v11)
    return v12
}

; Float aggregates past v7 go on the stack at their own alignment: the
; first at 0, the f32 at 12, the second at 16.
func @k_fstack(f64, f64, f64, f64, f64, f64, f64, f64, ptr byval {f32, f32, f32}, f32, ptr byval {f32, f32, f32}) -> i64 {
block0(v0: f64, v1: f64, v2: f64, v3: f64, v4: f64, v5: f64, v6: f64, v7: f64, v8: ptr, v9: f32, v10: ptr):
    v11 = call @h_fstack(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10)
    return v11
}

func @k_pass_fstack(ptr, ptr) -> i64 {
block0(v0: ptr, v1: ptr):
    v2 = fconst.f64 1.0
    v3 = fconst.f64 2.0
    v4 = fconst.f64 3.0
    v5 = fconst.f64 4.0
    v6 = fconst.f64 5.0
    v7 = fconst.f64 6.0
    v8 = fconst.f64 7.0
    v9 = fconst.f64 8.0
    v10 = fconst.f32 0.75
    v11 = call @c_fstack(v2, v3, v4, v5, v6, v7, v8, v9, v0, v10, v1)
    return v11
}

; The callee's copy is its own to change.
func @k_scribble_big(ptr byval {[5 x i64]}) -> i64 {
block0(v0: ptr):
    v1 = iconst.i64 40
    call @scribble(v0, v1)
    v2 = call @h_big(v0)
    return v2
}

func @k_scribble_s16(ptr byval {i64, i64}) -> i64 {
block0(v0: ptr):
    v1 = iconst.i64 16
    call @scribble(v0, v1)
    v2 = call @h_s16(v0)
    return v2
}

; keel to keel.
func @k_k_s16(ptr) -> i64 {
block0(v0: ptr):
    v1 = call @k_s16(v0)
    return v1
}

; The callee scribbles over its copy; ours must be intact afterwards.
func @k_k_big(ptr) -> i64 {
block0(v0: ptr):
    v1 = call @k_scribble_big(v0)
    v2 = call @h_big(v0)
    return v2
}


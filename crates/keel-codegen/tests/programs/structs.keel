decl @h_f4(ptr) -> i64
decl @c_dl(ptr byval {f64, i64}) -> i64
decl @h_dl(ptr) -> i64
decl @c_c3(ptr byval {i8, i8, i8}) -> i64
decl @h_c3(ptr) -> i64

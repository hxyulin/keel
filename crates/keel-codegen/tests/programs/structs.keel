; keel makes structs with its own functions and passes them on.
func @k_roundtrip(i64) -> i64 {
    ss0 = stack_slot 16, align 8
    ss1 = stack_slot 40, align 8
block0(v0: i64):
    v1 = stack_addr ss0
    call @k_make_s16(v1, v0)
    v2 = stack_addr ss1
    call @k_make_big(v2, v0)
    v3 = call @k_s16(v1)
    v4 = call @k_big(v2)
    v5 = iadd v3, v4
    return v5
}

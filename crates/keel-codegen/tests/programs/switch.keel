; expect: exit 0
; `switch`, checked against C's switch in switch.c: jump tables (dense
; cases, including ones not starting at 0 or needing a materialized base),
; compare chains (sparse, large and negative cases), narrow types, and
; targets with block arguments in a loop.

; Dense: a jump table with gaps that go to the default.
func @dense(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 100
    switch v0, block5, [0: block1, 1: block2, 2: block1, 4: block3(v0), 5: block4, 7: block2, 8: block3(v1)]
block1:
    v2 = iconst.i32 10
    return v2
block2:
    v3 = iconst.i32 20
    return v3
block3(v4: i32):
    v5 = iconst.i32 1000
    v6 = iadd v4, v5
    return v6
block4:
    v7 = iconst.i32 50
    return v7
block5:
    v8 = iconst.i32 -1
    return v8
}

; Dense around 1000, in i64: the table is indexed by x - 1000.
func @dense_off(i64) -> i64 {
block0(v0: i64):
    switch v0, block2(v0), [1000: block1, 1001: block2(v0), 1002: block1, 1003: block1, 1005: block2(v0)]
block1:
    v1 = iconst.i64 7
    return v1
block2(v2: i64):
    v3 = iconst.i64 2
    v4 = imul v2, v3
    return v4
}

; Dense around 70000, past what `sub` can take as an immediate.
func @dense_big(i32) -> i32 {
block0(v0: i32):
    v1 = iconst.i32 1
    v2 = iconst.i32 2
    v3 = iconst.i32 3
    switch v0, block2(v0), [70000: block2(v1), 70001: block2(v2), 70002: block2(v3), 70003: block1, 70004: block2(v1)]
block1:
    v4 = iconst.i32 99
    return v4
block2(v5: i32):
    return v5
}

; Sparse: a chain of compares, with values that need materializing.
func @sparse(i64) -> i64 {
block0(v0: i64):
    switch v0, block4, [-1: block1, 0x123456789: block2, 5000: block3, 3: block1]
block1:
    v1 = iconst.i64 11
    return v1
block2:
    v2 = iconst.i64 22
    return v2
block3:
    v3 = iconst.i64 33
    return v3
block4:
    v4 = iconst.i64 44
    return v4
}

; i8, with negative cases: compared as bits, so 255 and -1 are the same.
func @narrow(i8) -> i32 {
block0(v0: i8):
    switch v0, block3, [-128: block1, 255: block2, 0: block1, 127: block2]
block1:
    v1 = iconst.i32 1
    return v1
block2:
    v2 = iconst.i32 2
    return v2
block3:
    v3 = iconst.i32 3
    return v3
}

; A state machine run for n steps, cycling through states 0, 1 and 2. The
; step and accumulator travel as block arguments through the switch's
; edges, in a different order on each.
func @machine(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    jump block1(v1, v1, v1)
block1(v2: i64, v3: i64, v4: i64):             ; i, state, acc
    v5 = icmp.ult v2, v0
    brif v5, block2, block7(v4)
block2:
    v6 = iconst.i64 1
    v7 = iadd v2, v6
    switch v3, block6(v7, v4), [0: block3(v7, v4), 1: block4(v4, v7), 2: block5(v7, v4)]
block3(v8: i64, v9: i64):                      ; state 0: acc += 1, go to 1
    v10 = iadd v9, v6
    jump block1(v8, v6, v10)
block4(v11: i64, v12: i64):                    ; state 1: acc *= 3, go to 2
    v13 = iconst.i64 3
    v14 = imul v11, v13
    v15 = iconst.i64 2
    jump block1(v12, v15, v14)
block5(v16: i64, v17: i64):                    ; state 2: acc -= i, go to 0
    v18 = isub v17, v16
    v19 = iconst.i64 0
    jump block1(v16, v19, v18)
block6(v20: i64, v21: i64):                    ; unreachable state
    v22 = iconst.i64 -1
    jump block7(v22)
block7(v23: i64):
    return v23
}

; A constant switch, which simplify-cfg folds to a jump under -O.
func @constant() -> i32 {
block0:
    v0 = iconst.i32 5
    switch v0, block1, [4: block1, 5: block2]
block1:
    v1 = iconst.i32 0
    return v1
block2:
    v2 = iconst.i32 1
    return v2
}

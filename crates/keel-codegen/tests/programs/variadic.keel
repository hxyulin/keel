; expect: exit 0
; Variadic functions defined in keel, checked in variadic.c: va_start and
; va_arg, and variadic arguments after named ones that spill to the stack.
; Passing a va_list on is ABI-specific: see variadic_vprintf*.keel.
; Sum of n i64 arguments.
func @k_sum(i32, ...) -> i64 {
    ss0 = stack_slot 32, align 8        ; va_list: 8 bytes on Darwin ARM64, 24 on SysV, 32 on Linux ARM64
block0(v0: i32):
    v1 = stack_addr ss0
    intrinsic va_start(v1)
    v2 = iconst.i64 0
    v3 = iconst.i32 0
    jump block1(v3, v2)
block1(v4: i32, v5: i64):
    v6 = icmp.slt v4, v0
    brif v6, block2, block3
block2:
    v7 = va_arg.i64 v1
    v8 = iadd v5, v7
    v9 = iconst.i32 1
    v10 = iadd v4, v9
    jump block1(v10, v8)
block3:
    return v5
}

; Reads (i32, f64) pairs n times: sum of i * d.
func @k_pairs(i32, ...) -> f64 {
    ss0 = stack_slot 32, align 8
block0(v0: i32):
    v1 = stack_addr ss0
    intrinsic va_start(v1)
    v2 = fconst.f64 0.0
    v3 = iconst.i32 0
    jump block1(v3, v2)
block1(v4: i32, v5: f64):
    v6 = icmp.slt v4, v0
    brif v6, block2, block3
block2:
    v7 = va_arg.i32 v1
    v8 = va_arg.f64 v1
    v9 = sitofp.f64 v7
    v10 = fmul v9, v8
    v11 = fadd v5, v10
    v12 = iconst.i32 1
    v13 = iadd v4, v12
    jump block1(v13, v11)
block3:
    return v5
}

; Eight named integers fill x0-x7 and a ninth goes on the stack, so the
; variadic arguments start one slot further up. Returns the ninth plus
; the first two variadic ones (a ptr's target and an i64).
func @k_tail(i64, i64, i64, i64, i64, i64, i64, i64, i32, ...) -> i64 {
    ss0 = stack_slot 32, align 8
block0(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i32):
    v9 = stack_addr ss0
    intrinsic va_start(v9)
    v10 = va_arg.ptr v9
    v11 = load.i64 v10
    v12 = va_arg.i64 v9
    v13 = sext.i64 v8
    v14 = iadd v13, v11
    v15 = iadd v14, v12
    v16 = iadd v15, v7
    return v16
}

; keel calling its own variadic function.
func @k_sum_three(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    v3 = iconst.i32 3
    v4 = call @k_sum(v3, v0, v1, v2)
    return v4
}

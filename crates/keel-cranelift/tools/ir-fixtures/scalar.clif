function %probe(i64, i64) -> i64 apple_aarch64 {
block0(v0: i64, v1: i64):
    v2 = icmp ult v0, v1
    brif v2, block1, block2
block1:
    v3 = iadd v0, v1
    v4 = ishl v0, v1
    v5 = bxor v3, v4
    jump block3(v5)
block2:
    v6 = isub v0, v1
    jump block3(v6)
block3(v7: i64):
    return v7
}

; `sext`/`uext` say how C widens a char or short argument or result.
decl @putc_signed(i8 sext, i16 uext) -> i8 sext

func @f(i8 uext) -> (i16 sext) {
block0(v0: i8):
    v1 = iconst.i16 -1
    v2 = call @putc_signed(v0, v1)
    v3 = symbol_addr @putc_signed
    v4 = call_indirect v3(v0, v1) : (i8 sext, i16 uext) -> i8 sext
    return v1
}

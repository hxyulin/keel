; Atomic accesses take a C11 ordering after the opcode. A compare-and-swap
; takes a success and a failure ordering, may be weak, and gives the old
; value and a flag.
func @f(ptr, i32, ptr) -> i32 cc(c) {
block0(v0: ptr, v1: i32, v2: ptr):
    v3 = atomic_load.i32 acquire v0
    atomic_store release v1, v0
    v4 = atomic_rmw.add seq_cst v0, v1
    v5 = atomic_rmw.umax relaxed v0, v3
    v6, v8 = atomic_cas acq_rel acquire v0, v3, v4
    v9, v10 = atomic_cas weak seq_cst relaxed v0, v3, v1
    v11, v12 = atomic_cas release acquire v0, v1, v3
    v13, v14 = atomic_cas relaxed seq_cst v0, v1, v3
    v7 = atomic_rmw.xchg seq_cst v2, v0
    fence acquire
    fence seq_cst
    return v6
}

; i128 atomics need 16-byte alignment, like every atomic its size.
func @wide(ptr, i128) -> i128 cc(c) {
block0(v0: ptr, v1: i128):
    v2 = atomic_load.i128 seq_cst v0
    atomic_store release v1, v0
    v3, v4 = atomic_cas weak acq_rel acquire v0, v2, v1
    v5 = atomic_rmw.smax relaxed v0, v3
    return v5
}

; passes: gcm
; Loop-invariant `v5 = imul v1, v1` leaves the loop for the entry block;
; `v9`, needed only on the exit path, sinks into it. Constants are
; rematerialized next to their uses instead of hoisted.
func @f(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst.i64 0
    v9 = imul v0, v1
    jump block1(v2, v2)

block1(v3: i64, v4: i64):
    v5 = imul v1, v1
    v6 = iadd v4, v5
    v7 = iconst.i64 1
    v8 = iadd v3, v7
    v10 = icmp.ult v8, v0
    brif v10, block1(v8, v6), block2

block2:
    v11 = iadd v6, v9
    v12 = iadd v11, v7          ; v7 is used in two blocks: each gets a copy
    return v12
}

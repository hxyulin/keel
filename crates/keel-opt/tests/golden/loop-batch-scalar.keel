 v3 = iconst.i64 0
 jump block1(v3,v2)
block1(v4:i64,v5:f64):
 v6 = icmp.ult v4,v1
 brif v6,block2,block3
block2:
 v7 = iconst.i64 3
 v8 = shl v4,v7
 v9 = ptradd v0,v8
 v10 = load.f64 trap_ub v9
 v11 = fabs v10
 v12 = fadd v5,v11
 v13 = iconst.i64 1
 v14 = iadd v4,v13
 jump block1(v14,v12)
block3:
 return v5
}

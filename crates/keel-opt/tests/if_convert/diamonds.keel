func @diamond8(i8 uext, i8 uext, i8 uext) -> i8 uext cc(c) {
block0(v0: i8, v1: i8, v2: i8):
 brif v0, block1(v1,v2), block2(v2,v1)
block1(v3: i8,v4: i8):
 v5 = iadd v3,v4
 jump block3(v5,v3)
block2(v6: i8,v7: i8):
 v8 = isub v6,v7
 jump block3(v8,v6)
block3(v9: i8,v10: i8):
 v11 = xor v9,v10
 return v11
}

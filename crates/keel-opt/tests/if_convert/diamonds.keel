func @guarded_div(i8 uext,i64,i64) -> i64 cc(c) {
block0(v0: i8,v1: i64,v2: i64):
 brif v0,block1,block2
block1:
 v3 = sdiv v1,v2
 jump block3(v3)
block2:
 jump block3(v1)
block3(v4: i64):
 return v4
}
func @guarded_load(i8 uext,ptr,i64) -> i64 cc(c) {
block0(v0: i8,v1: ptr,v2: i64):
 brif v0,block1,block2
block1:
 v3 = load.i64 v1
 jump block3(v3)
block2:
 jump block3(v2)
block3(v4: i64):
 return v4

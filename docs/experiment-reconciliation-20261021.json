    },
    {
      "experiment": "Large stack promotion",
      "decision": "Fixed \u00b7 keep opt-in",
      "reason": "Capped admission allocation and wide-switch work. Pruned SSA remains useful; application benefit is small."
    },
    {
      "experiment": "Call/load reuse",
      "decision": "Fixed \u00b7 keep opt-in",
      "reason": "Cheaper admission. Moving it earlier did not clearly beat the previous combined schedule; reject that schedule."
    },
    {
      "experiment": "Wide adjacent SIMD",
      "decision": "Keep for isolated promotion trial",
      "reason": "About 61% less target-loop time than cleanup-only at 4K/1M elements; current Full still excludes it."
    },
    {
      "experiment": "Narrow adjacent SIMD",
      "decision": "Park; no further expansion",
      "reason": "Largest-array narrow/wide ratio changed from 0.862 to 1.033 across two screens. No stable incremental win."
    },
    {
      "experiment": "Running-state predication",
      "decision": "Fixed \u00b7 keep candidate",
      "reason": "Lazy CFG removes repeated whole-function analysis. At 4K/1M, target-loop time is 0.786/0.322 \u00d7 cleanup-only."
    },
    {
      "experiment": "Aggregate-return",
      "decision": "Retire from shipping registry",
      "reason": "No change on all 44 current application translation units. Preserve standalone proof tests and probe."
    },
    {
      "experiment": "Aggregate inline reserve",
      "decision": "Keep reference; do not substitute for Full",
      "reason": "Still activates, but it replaces Full\u2019s binding-aware policy. Its large cloning totals are not reserve-only gains."
    },
    {
      "experiment": "ARM dispatch tails",
      "decision": "Feature-isolated",
      "reason": "Now requires experimental-dispatch. Retained app timings had this feature disabled and cannot justify promotion."
    },
    {
      "experiment": "Prefix / Local / Split / Weighted / affinity / remat",
      "decision": "Freeze allocator research",
      "reason": "Prefix policy is already outside root. Remaining modes stay behind experimental-regalloc; retain shared machinery."
    },
    {
      "experiment": "Load narrowing",
      "decision": "Park",
      "reason": "No demonstrated production C activation in retained evidence; do not relax fault/readability proofs just to get hits."
    },
    {
      "experiment": "Stack cache / loop memory / CFG forwarding",
      "decision": "Keep separate, off by default",
      "reason": "Distinct legality domains, shared machinery or small wrappers. Not demonstrated universal losers."
    },
    {
      "experiment": "Affine/cast reduction aliases",
      "decision": "Keep compatibility aliases",
      "reason": "They share the multi-reduction implementation; removing names would save little code and break explicit pipelines."
    },
    {
      "experiment": "Packed widening / masks / abs / minmax / exact loads",
      "decision": "Keep production lowering",
      "reason": "These instruction-selection improvements serve ordinary IR; they are not the optional loop-producer experiments."
    }

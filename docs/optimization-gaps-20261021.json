  "features": [
    {
      "rank": 1,
      "name": "Scalar replacement across calls and large CFGs",
      "status": "Limited",
      "evidence": "Stack promotion rejects >256 blocks or >8192 instructions. Exact Full VM event: 956 blocks, 9159 instructions, unchanged. Escaping slot addresses remain conservative; aggregate-return only proves a narrow leaf-constructor pattern.",
      "files": [
        "crates/keel-opt/src/stack_promote.rs:15",
        "crates/keel-opt/src/stack_promote.rs:107",
        "crates/keel-opt/src/aggregate_return.rs"
      ],
      "next": "Bounded per-slot or region-based promotion, then direct aggregate-result field forwarding; preserve capture, initialization, alignment, debug, exception and frame-observer proofs. Merely raising the function cap does not prove accesses promotable."
    },
    {
      "rank": 2,
      "name": "Call memory/capture summaries and global memory optimization",
      "status": "Missing general infrastructure",
      "evidence": "All Call/CallIndirect/Invoke instructions are memory barriers in InstData::memory_effects. FunctionAttrs lacks readonly/readnone or capture summaries. load-reuse is bounded to unique-predecessor chains, 8 edges and 128 facts; no join/loop fixed point. Alias facts recognize constant ptradd paths and restricted roots.",
      "files": [
        "crates/keel-ir/src/inst.rs:557",
        "crates/keel-ir/src/function.rs:167",
        "crates/keel-opt/src/load_reuse.rs:1",
        "crates/keel-opt/src/memory_alias.rs:1",
        "crates/keel-opt/src/gvn.rs:1"
      ],
      "next": "Infer conservative summaries only for legally bound direct callees. Add join-aware memory availability and precise invalidation. Build a MemorySSA-like layer if multiple consumers justify it; MemorySSA alone is not an optimization or a source of alias proofs."
    },
    {
      "rank": 3,
      "name": "Inlining profitability and specialization",
      "status": "Present; budget policy gap",
      "evidence": "QuickJS sorting regression traced to the shared module budget rejecting cheap helpers in all three rounds. Constructor priority also provides real benefits. No general function-specialization framework found in the audited optimizer.",
      "files": [
        "crates/keel-opt/src/inline.rs:128",
        "crates/keel-opt/src/inline.rs:634"
      ],
      "next": "Retain tiny constructor priority; reserve bounded capacity for profitable cheap call sites. Longer term specialize small wrappers for constant arguments, with binding and code-growth limits."
    },
    {
      "rank": 4,
      "name": "General loop optimization and SLP vectorization",
      "status": "Pattern-based coverage",
      "evidence": "GCM hoists pure computations. loop-memory recognizes small unrotated two-block loops; Full does not schedule it. Loop vectorizer supports bounded shapes plus specialized reductions; no SLP vectorizer found.",
      "files": [
        "crates/keel-opt/src/gcm.rs:1",
        "crates/keel-opt/src/loop_memory.rs:1",
        "crates/keel-opt/src/loop_vectorize.rs:1",
        "crates/keel-opt/src/lib.rs:381"
      ],
      "next": "Broader loop facts, guarded invariant memory motion, then SLP packing of adjacent scalar work. Important across general programs; not yet demonstrated to dominate these interpreter workloads."
    },
    {
      "rank": 5,
      "name": "Machine scheduling, hot-path layout and allocation",
      "status": "Backend maturity gap",
      "evidence": "Default Fast/Full have one location per SSA value and no interval splitting. Layout follows allocation order. Dedicated target-latency machine scheduling is not present in the audited codegen path. Bounded dispatch-tail replication exists as an explicit experiment.",
      "files": [
        "crates/keel-codegen/src/regalloc.rs:1",
        "crates/keel-codegen/src/aarch64.rs:1224",
        "crates/keel-codegen/src/aarch64/dispatch_tail.rs:1"
      ],
      "next": "Use exact hot-path evidence to prioritize layout and dependency scheduling. Existing experimental allocator directions stay parked; this audit does not justify changing the default allocator."
    }

  "proofs": [
    {
      "test": "analysis_exhaustion_preserves_completed_fields_and_leaves_suffix_untouched",
      "setup": "40 independent one-block fields plus 64000 inert instructions; valid input under all function limits.",
      "assertions": [
        "A nonempty strict prefix is promoted, with fewer than 32 completed fields. No parameters are added, excluding the independent field and parameter caps as explanations.",
        "Every completed store/load is removed; every suffix store/load retains exactly its original instruction data. Module verification and reparsed verification pass.",
        "A second invocation with a fresh analysis budget promotes the remaining legal fields; the original return resolves to the initial seed."
      ]
    },
    {
      "test": "shared_covering_initializer_survives_later_field_cutoff",
      "setup": "31 earlier independent fields followed by two i32 halves sharing one i64 repeated-byte initializer.",
      "assertions": [
        "The first half is the 32nd promoted field. The second i32 read and complete original i64 store remain unchanged; exactly those two memory operations survive.",
        "A fresh invocation promotes the second half and removes the now-dead covering store. Verification and the independent interpreter confirm the returned UINT32_MAX value."
      ]
    }
  ],

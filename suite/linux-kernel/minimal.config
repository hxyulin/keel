# Linux v6.12 allnoconfig fragment. This is an audit/boot fixture, not a
# production kernel configuration. The resolved config is pinned separately.
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_EMBEDDED=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
CONFIG_BINFMT_ELF=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_MULTIUSER=y
CONFIG_X86_IOPL_IOPERM=y
CONFIG_UNWINDER_FRAME_POINTER=y
